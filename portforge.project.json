{
  "$schema": "port_forge/schemas/portforge-project-v1.schema.json",
  "format": "portforge-project-v1",
  "game": "game.json",
  "portforge": "port_forge",
  "assets": "assets",
  "player": {
    "default_runtime": "oracle",
    "runtimes": {
      "oracle": {
        "supported": true,
        "adapter": "scripts/play.py:mac68k-event-poll-live-session",
        "build_hint": "python scripts/play.py",
        "replay": {
          "supported": true,
          "boundary_profile": "profiles/replay-boundaries-v1.json",
          "implementation_plan": "recovery/execution-plan-oracle.json"
        }
      },
      "generated": {
        "supported": true,
        "adapter": "scripts/play.py:mac68k-generated-with-fallback",
        "build_hint": "python scripts/play.py --runtime generated",
        "fallback": {
          "mode": "interpreter",
          "coverage": "partial",
          "observable": true,
          "evidence": [
            "native/simant_mac_generated.hpp",
            "artifacts/evidence/canonical-event-poll-generated-v3.json",
            "recovery/execution-plan-generated.json"
          ],
          "notes": "mac.code.1.4 and the linear leaf mac.code.2.2906 are generated and exact-source guarded; all remaining instructions retain explicit interpreter fallback."
        },
        "replay": {
          "supported": true,
          "boundary_profile": "profiles/replay-boundaries-v1.json",
          "implementation_plan": "recovery/execution-plan-generated.json"
        }
      },
      "port": {
        "supported": false,
        "reason": "No PortForge-independent Macintosh source port exists."
      }
    }
  },
  "corpora": {
    "recovery": [
      "canonical-event-poll-v2"
    ]
  },
  "artifacts": {
    "replay_boundaries": "profiles/replay-boundaries-v1.json",
    "platform_capabilities": "portforge.capabilities.json",
    "implementation_catalog": "recovery/implementation-catalog.json",
    "execution_plan_oracle": "recovery/execution-plan-oracle.json",
    "execution_plan_generated": "recovery/execution-plan-generated.json",
    "execution_plan_oracle_detachment": "recovery/execution-plan-oracle.detachment.json",
    "execution_plan_generated_detachment": "recovery/execution-plan-generated.detachment.json",
    "canonical_replay": "artifacts/replays/canonical-event-poll-v2.pfreplay.json",
    "replay_evidence_oracle": "artifacts/evidence/canonical-event-poll-oracle-v3.json",
    "replay_evidence_generated": "artifacts/evidence/canonical-event-poll-generated-v3.json",
    "atlas": "artifacts/atlas.pfatlas",
    "canonical_regressions": "regressions/manifest.json",
    "replay_conformance": "recovery/replay-conformance.json",
    "snapshot_conformance": "recovery/snapshot-conformance.json",
    "replays": "artifacts/replays",
    "snapshots": "artifacts/snapshots",
    "function_census": "artifacts/analysis/mac_function_census.json",
    "native_function_conformance": "recovery/native-function-conformance.json"
  },
  "known_gaps": [
    {
      "severity": "risk",
      "scope": "live-atlas",
      "summary": "Offline Atlas is regeneratable evidence; live M68K Atlas awaits stable-identity observer fan-out beside ReplaySessionEvidence.",
      "evidence": "README.md"
    },
    {
      "severity": "risk",
      "scope": "canonical-output",
      "summary": "Machine snapshots preserve deterministic QuickDraw and Sound Manager source state, but canonical audio/video stream hashing is not yet a project conformance gate.",
      "evidence": "recovery/snapshot-conformance.json"
    },
    {
      "severity": "risk",
      "scope": "assets",
      "summary": "Boot requires the original HFS image, resource fork, and Finder metadata.",
      "evidence": "docs/asset-inventory.md"
    }
  ],
  "workflows": {
    "play": {
      "command": ["python", "scripts/play.py"],
      "scope": "interactive-oracle",
      "description": "Run the original HFS application through the Mac68k oracle."
    },
    "record-canonical-replay": {
      "command": ["python", "scripts/play.py", "--record-replay", "canonical-event-poll-v2", "--replay-boundary-limit", "8", "--exit-after-replay", "--no-snapshot-on-crash", "--unthrottled"],
      "scope": "semantic-replay-recording",
      "description": "Record the canonical ReplayArtifactV2 at Event Manager poll boundaries."
    },
    "verify-replay": {
      "command": ["python", "scripts/verify_replay.py", "--build"],
      "scope": "semantic-replay-conformance",
      "description": "Validate the current artifact and play it twice fail-closed.",
      "gate": true
    },
    "verify-generated-replay": {
      "command": ["python", "scripts/play.py", "--runtime", "generated", "--verify-replay", "canonical-event-poll-v2", "--no-snapshot-on-crash", "--unthrottled", "--no-host-input"],
      "scope": "cross-execution-replay",
      "description": "Build the generated-with-fallback runner and verify the canonical artifact with uniquely named execution-bound layer evidence.",
      "gate": true
    },
    "verify-native-entry": {
      "command": ["python", "scripts/verify_native_entry.py"],
      "scope": "native-replacement-parity",
      "description": "Regenerate native code and compare the generated entry instruction and first recovered leaf function with the 68k oracle, including poison and source guards.",
      "gate": true
    },
    "build-function-census": {
      "command": ["python", "scripts/build_function_census.py"],
      "scope": "mac68k-recovery-control-plane",
      "description": "Verify the stable-identity MPW export census and generated-function state projection are current.",
      "gate": true
    },
    "package-generated-release": {
      "command": ["python", "scripts/package_release.py", "--dist", "build/release-verification"],
      "scope": "generated-windows-bundle",
      "description": "Build and verify the generated-with-fallback Windows bundle in a clean verification output without touching a user-populated dist directory.",
      "gate": true
    },
    "collect-replay-evidence": {
      "command": ["python", "scripts/play.py", "--verify-replay", "canonical-event-poll-v2", "--evidence-out", "artifacts/evidence/canonical-event-poll-oracle-v3.json", "--no-snapshot-on-crash"],
      "scope": "normalized-replay-observation",
      "description": "Replay the canonical artifact and publish execution-bound Mac68k EvidenceV3."
    },
    "rebuild-atlas": {
      "command": ["python", "port_forge/tools/pf_project.py", "atlas", ".", "rebuild-evidence", "artifacts/evidence/canonical-event-poll-oracle-v3.json"],
      "scope": "regeneratable-evidence-projection",
      "description": "Delete and atomically rematerialize Atlas from oracle EvidenceV3; generated parity remains separate evidence to avoid duplicate interpreted occurrences."
    },
    "verify-snapshot-resume": {
      "command": ["python", "scripts/verify_snapshot_resume.py", "--build"],
      "scope": "machine-continuation",
      "description": "Compare a real resumed run byte-for-byte with uninterrupted execution.",
      "gate": true
    },
    "inspect-replay": {
      "command": ["python", "scripts/play.py", "--inspect-replay", "canonical-event-poll-v2"],
      "scope": "artifact-inspection",
      "description": "Authenticate and summarize ArtifactV2 through the shared artifact tool."
    },
    "check-player-interface": {
      "command": ["python", "scripts/check_play_interface.py"],
      "scope": "launcher-architecture-guard",
      "description": "Guard aliases, strict forwarding, shared identity bindings, and retired authority removal.",
      "gate": true
    },
    "resume-live-session": {
      "command": ["python", "scripts/play.py", "--snapshot", "PATH.pfsession.json"],
      "scope": "replay-session-continuation",
      "description": "Resume direct, recording-draft, or playback mode from an F12 publication."
    },
    "plan-oracle": {
      "command": ["python", "port_forge/tools/pf_project.py", "plan", ".", "oracle-interpreter", "--output", "recovery/execution-plan-oracle.json"],
      "scope": "execution-planning",
      "description": "Resolve the exact Mac oracle dependency closure."
    },
    "plan-generated": {
      "command": ["python", "port_forge/tools/pf_project.py", "plan", ".", "generated-with-fallback", "--output", "recovery/execution-plan-generated.json"],
      "scope": "execution-planning",
      "description": "Resolve the generated-with-interpreter-fallback dependency closure."
    },
    "platform-status": {
      "command": ["python", "port_forge/tools/pf_project.py", "platform", "status", ".", "--platform", "mac68k"],
      "scope": "control-plane",
      "description": "Report evidence-backed Mac68k maturity."
    },
    "platform-doctor": {
      "command": ["python", "port_forge/tools/pf_project.py", "platform", "doctor", ".", "--platform", "mac68k"],
      "scope": "control-plane",
      "description": "Report the next missing Mac68k capability dependency."
    }
  }
}
